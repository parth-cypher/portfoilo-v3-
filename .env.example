# Work With Me form — copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never prefix these with VITE_: that would expose them to the browser.

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Inbox that receives inquiries (defaults to parthpatil8106@gmail.com).
INQUIRY_TO=

# Optional. Sender for the notification. Without a verified domain, leave empty to
# use Resend's test sender (it can only deliver to your own Resend account email).
INQUIRY_FROM=

# Optional. Set only after verifying a domain in Resend, e.g.
#   CONFIRMATION_FROM="Parth Patil <hello@yourdomain.com>"
# When set, clients also receive an automatic confirmation email.
CONFIRMATION_FROM=
